# ------------------------------------------------------------------
# CMA Decision Platform — environment template
# Copy to `.env` and adjust. Never commit real secrets.
# ------------------------------------------------------------------

# --- Backend ---
# SQLite (default, zero-dependency local dev). File is created automatically.
DATABASE_URL=sqlite:///./cma.db
# PostgreSQL via docker-compose (uncomment to use):
# DATABASE_URL=postgresql+psycopg2://cma:cma_dev_password@localhost:5432/cma

# Comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- docker-compose (local Postgres option only; not real credentials) ---
POSTGRES_USER=cma
POSTGRES_PASSWORD=cma_dev_password
POSTGRES_DB=cma
